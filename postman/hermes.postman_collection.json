{
  "info": {
    "name": "Hermes — API Frankfurter",
    "description": "Requisições estudadas para o Currency Exchange App.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.frankfurter.dev/v1"
    }
  ],
  "item": [
    {
      "name": "Moedas disponíveis",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('contém USD e BRL', () => { const j = pm.response.json(); pm.expect(j).to.have.property('USD'); pm.expect(j).to.have.property('BRL'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/currencies",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "currencies"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Cotação mais recente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('traz data e taxa', () => { const j = pm.response.json(); pm.expect(j.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/); pm.expect(j.rates.BRL).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/latest?base=USD&symbols=BRL",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "latest"
          ],
          "query": [
            {
              "key": "base",
              "value": "USD"
            },
            {
              "key": "symbols",
              "value": "BRL"
            }
          ]
        }
      }
    },
